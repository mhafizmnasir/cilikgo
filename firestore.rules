rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function me() { return userDoc(request.auth.uid); }
    function isAdmin() { return signedIn() && me().data.role == 'admin'; }
    function isAgent() { return signedIn() && me().data.role == 'agent'; }
    function ownsChild(childId) {
      return signedIn()
        && exists(/databases/$(database)/documents/children/$(childId))
        && get(/databases/$(database)/documents/children/$(childId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      // Akaun baru tidak boleh mencipta dirinya sebagai Admin atau bermula dengan langganan aktif.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['user','agent']
        && request.resource.data.subscriptionStatus == 'inactive'
        && (
          (request.resource.data.role == 'user' && request.resource.data.agentCode == null)
          || (request.resource.data.role == 'agent'
              && request.resource.data.agentCode == 'CG-' + request.auth.uid)
        );

      // Agent hanya boleh membaca profil Penjaga yang benar-benar dirujuk oleh kod Agent sendiri.
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isAgent()
            && resource.data.role == 'user'
            && resource.data.referredByCode == me().data.agentCode)
      );

      // Pengguna biasa hanya boleh ubah medan profil yang tidak sensitif.
      // role, agentCode, referredByCode dan semua status/langganan tidak boleh diubah dari browser.
      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','email','phone','updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    match /children/{childId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 4
        && request.resource.data.age <= 6;
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 4
        && request.resource.data.age <= 6;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /progress/{progressId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.childId is string
        && ownsChild(request.resource.data.childId)
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 3
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 15
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 1
        && request.resource.data.attempts <= 100;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.userUid == request.auth.uid
        || resource.data.agentUid == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /commissions/{id} {
      allow read: if signedIn() && (resource.data.agentUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /subscriptionAudit/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
